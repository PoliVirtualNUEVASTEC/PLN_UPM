# Unity — merge de escenas y prefabs con la herramienta que trae el editor.
# Aun asi, la regla 5 del equipo manda: conflicto en .unity o .prefab -> se descarta y se rehace.
*.unity     merge=unityyamlmerge eol=lf
*.prefab    merge=unityyamlmerge eol=lf
*.asset     merge=unityyamlmerge eol=lf
*.mat       merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf

# Texto normalizado
*.cs        text diff=csharp
*.asmdef    text
*.json      text
*.md        text

# Binarios
*.onnx      binary
*.wav       binary
*.png       binary
*.fbx       binary

# Git LFS — binarios vendorizados de M1 (motor Vosk + modelo es-CO, decidido antes
# del primer commit de estos archivos: openspec/changes/m1-speech-to-text/design.md)
Runtime/Speech/Plugins/**/*.so  filter=lfs diff=lfs merge=lfs -text
Runtime/Speech/Plugins/**/*.dll filter=lfs diff=lfs merge=lfs -text
Runtime/Speech/Plugins/**/*.bytes filter=lfs diff=lfs merge=lfs -text
